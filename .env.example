# StudyMind Web — local development
# Copy to .env.local: cp .env.example .env.local
# Never commit .env.local, live Stripe keys, database passwords, or API secrets.
# Restart 'npm run dev' after changing variables.

# REQUIRED — StudyMind Web PostgreSQL (local Docker example)
# Create a database named studymind_web; use your own username/password.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/studymind_web?schema=public"

# REQUIRED — must match the browser origin and port exactly for Stripe checkout.
APP_URL="http://localhost:3000"

# REQUIRED — 32+ random bytes. Generate with:
# openssl rand -base64 48
SESSION_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES"

# REQUIRED FOR AI — separate StudyMind AI FastAPI service.
# Use the local backend during integration testing; do not include /api/v1.
STUDYMIND_AI_BASE_URL="http://127.0.0.1:8000"
# StudyMind AI backend's platform API key. Must match the backend's configured key.
# Server-only; never use a NEXT_PUBLIC_ prefix.
STUDYMIND_AI_PLATFORM_API_KEY="REPLACE_WITH_BACKEND_PLATFORM_API_KEY"

# REQUIRED FOR CHECKOUT — Stripe TEST mode only for local testing.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
# From 'stripe listen --forward-to localhost:3000/api/billing/webhook'
# Copy the whsec_ value printed by the Stripe CLI (not the Dashboard endpoint secret).
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
# Stripe TEST mode one-time Price ID for the StudyMind access pass.
STRIPE_ACCESS_PRICE_ID="price_REPLACE_ME"
# Access duration granted after confirmed payment (1–365 days).
ACCESS_PASS_DAYS="28"

# OPTIONAL DISPLAY ONLY — copy the amount/currency from your Stripe TEST Price.
# These are not used for charging; Stripe checkout always uses STRIPE_ACCESS_PRICE_ID.
# Set these to exactly match the Stripe Price to avoid misleading checkout copy.
ACCESS_PASS_DISPLAY_PRICE=""
ACCESS_PASS_DISPLAY_CURRENCY="GBP"

# StudyMind AI backend has its own environment configuration (DB, AI provider,
# storage, vector search, platform key). Configure that in studymind-ai, not here.
# Do not set NEXT_PUBLIC_ variables for any secret.
