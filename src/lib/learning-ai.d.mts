export const COMPLEXITIES: readonly ['simple', 'normal', 'expert'];
export type Complexity = 'simple' | 'normal' | 'expert';
export const SCOPES: readonly ['everything', 'class_only', 'personal_only'];
export type Scope = 'everything' | 'class_only' | 'personal_only';
export const LIMITS: { message: number; topic: number; answer: number; quizQuestions: [number, number]; flashcards: [number, number] };
type Parsed<T> = { ok: true; value: T } | { ok: false; error: string };
export function parseTopic(v: unknown): Parsed<string | undefined>;
export function parseChatInput(b: unknown): Parsed<{ message: string; session_id?: string; complexity: Complexity; scope_mode: Scope }>;
export function parseQuizInput(b: unknown): Parsed<{ topic?: string; question_count: number }>;
export function parseFlashcardInput(b: unknown): Parsed<{ topic?: string; max_cards: number }>;
export function parseSummaryInput(b: unknown): Parsed<{ topic?: string }>;
export function parseQuizSubmit(b: unknown): Parsed<{ answers: { question_id: string; answer: string }[] }>;
export function toChatRequest(moduleId: string, v: { message: string; session_id?: string; complexity: Complexity; scope_mode?: Scope }): Record<string, unknown>;
export function toQuizRequest(moduleId: string, v: { topic?: string; question_count: number }): Record<string, unknown>;
export function toFlashcardRequest(moduleId: string, v: { topic?: string; max_cards: number }): Record<string, unknown>;
export function toSummaryRequest(moduleId: string, v: { topic?: string }): Record<string, unknown>;
export type Citation = { filename: string; snippet: string; document_id: string };
export type ChatResult = { answer: string; session_id: string | null; message_id: string | null; sources: Citation[]; grounded: boolean; no_content_found: boolean; suggestions: string[]; scope: string };
export type QuizOption = { id: string; text: string };
export type QuizQuestionOut = { id: string; position: number; question: string; options: QuizOption[] };
export type QuizGenerated = { attempt_id: string; title: string; questions: QuizQuestionOut[] };
export type QuizResult = { attempt_id: string; score: number; total: number; correct: number; questions: (QuizQuestionOut & { correct_answer: string; explanation: string; student_answer: string | null; is_correct: boolean })[] };
export type FlashcardDeck = { deck_id: string; title: string; cards: { id: string; position: number; front: string; back: string }[] };
export type SummaryResult = { id: string; content: string; advice: string | null; source_doc_count: number; created_at: string | null };
export function mapChat(raw: unknown): ChatResult | null;
export function mapQuizGenerated(raw: unknown): QuizGenerated | null;
export function mapQuizResult(raw: unknown): QuizResult | null;
export function mapFlashcards(raw: unknown): FlashcardDeck | null;
export function mapSummary(raw: unknown): SummaryResult | null;
export function splitSummary(content: string): { content: string; advice: string | null };
export function aiFailure(status: number, data: unknown): { status: number; error: string };
export type ChatSessionSummary = { id: string; title: string; updated_at: string | null; message_count: number };
export type ChatSessionMessage = { id: string; role: 'user' | 'assistant'; content: string; created_at: string | null; sources: Citation[] };
export type ChatSessionDetail = { id: string; title: string; messages: ChatSessionMessage[] };
export function sessionIds(raw: unknown): string[];
export function mapSessionList(raw: unknown): ChatSessionSummary[];
export function mapSessionDetail(raw: unknown): ChatSessionDetail | null;
